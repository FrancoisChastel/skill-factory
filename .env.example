# Copy to .env and fill in. Loaded by your shell or python-dotenv; never commit real keys.

# Anthropic (default harness + judge + optimizer LLM)
ANTHROPIC_API_KEY=sk-ant-...

# Optional: default models (overridable per-config)
SKILL_FACTORY_TARGET_MODEL=claude-sonnet-5
SKILL_FACTORY_OPTIMIZER_MODEL=claude-opus-4-8
SKILL_FACTORY_JUDGE_MODEL=claude-sonnet-5

# Optional: OpenAI-compatible backend (used by some DSPy/SkillOpt setups)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
